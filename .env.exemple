# --- Base de données --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB_Name
DB_USER=User
DB_PASSWORD=Password

# --- Génération (LLM) -------------------------------------------------------
# Local (défaut) : Ollama doit tourner, et le modèle être déjà tiré
#   ollama pull llama3.2
FOURNISSEUR_LLM=ollama
URL_LLM=http://localhost:11434
MODELE_LLM=llama3.2

# API compatible OpenAI : décommenter et renseigner les trois lignes.
# La base se termine par /v1 chez la plupart des fournisseurs.
#FOURNISSEUR_LLM=openai
#URL_LLM=https://exemple-fournisseur/v1
#MODELE_LLM=nom-du-modele-chez-ce-fournisseur
#CLE_API_LLM=votre_cle

# Réglages communs (valeurs par défaut de config.py, à ne changer qu'au besoin)
#TEMPERATURE_LLM=0
#FENETRE_CONTEXTE_LLM=8192
#DELAI_LLM=120
#NB_PASSAGES_CONTEXTE=5

# --- API REST (python -m api) -----------------------------------------------
#API_HOTE=127.0.0.1
#API_PORT=8000
# Origines autorisées depuis un navigateur, séparées par des virgules
#API_ORIGINES=http://localhost:3000
# 1 = autorise `details: true` aussi pour les clients (toujours ouvert aux conseillers)
#API_DETAILS=0
# Fichier des comptes conseillers (défaut : api/comptes_conseillers.json)
#FICHIER_COMPTES=
